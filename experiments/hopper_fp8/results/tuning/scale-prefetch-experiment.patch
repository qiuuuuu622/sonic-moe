+    @cute.jit
+    def load_fp8_scales(self, coords, SA, SB, varlen, tile,
+                       row_first: cutlass.Constexpr[tuple],
+                       col_values: cutlass.Constexpr[tuple], kb: Int32):
+        expert = tile[3]
+        begin = varlen.cu_seqlens_m[expert]
+        end = varlen.cu_seqlens_m[expert + 1]
+        ascale = cute.make_rmem_tensor((len(row_first),), Float32)
+        bscale = cute.make_rmem_tensor((len(col_values),), Float32)
+        for j in cutlass.range_constexpr(len(row_first)):
+            row = begin + tile[0] * self.cta_tile_shape_mnk[0] + coords[row_first[j]][0]
+            sa = Float32(0.0)
+            if row < end:
+                ar = row
+                if const_expr(varlen.mAIdx is not None):
+                    ar = varlen.mAIdx[row]
+                sa = SA[ar, kb]
+            ascale[j] = sa
+        for j in cutlass.range_constexpr(len(col_values)):
+            if const_expr(self.sgl_gate_layout):
+                col = (tile[1] * self.cta_tile_shape_mnk[1] // 256) + col_values[j] * (SB.shape[1] // 2)
+            else:
+                col = (tile[1] * self.cta_tile_shape_mnk[1] // 128) + col_values[j]
+            sb = Float32(0.0)
+            if col < SB.shape[1]:
+                sb = SB[expert, col, kb]
+            bscale[j] = sb
+        combined = cute.make_rmem_tensor((len(row_first), len(col_values)), Float32)
+        if const_expr(True):
+            for r in cutlass.range_constexpr(len(row_first)):
+                for c in cutlass.range_constexpr(len(col_values)):
+                    combined[r,c] = ascale[r] * bscale[c]
+        return combined
+
+    @cute.jit
+    def apply_fp8_scales(self, acc, total,
+                        row_map: cutlass.Constexpr[tuple],
+                        col_map: cutlass.Constexpr[tuple], combined,
+                        first: cutlass.Constexpr[bool]):
+        for i in cutlass.range_constexpr(cute.size(acc)):
+            v = acc[i] * combined[row_map[i], col_map[i]]
+            if const_expr(first):
+                total[i] = v
+            else:
+                total[i] = total[i] + v
+
